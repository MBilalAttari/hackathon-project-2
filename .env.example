# ========================================================
# HCM Lite - Environment Configuration Template
# ========================================================

# Firebase Client Configuration (Optional: built-in local persistent store runs out-of-the-box)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK Configuration (for server-side token verification and Firestore admin access)
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Hosted LLM API Key (Google Gemini API with tool calling)
# When set, uses live gemini-2.5-flash with function calling.
# When omitted, an intelligent server-side NLP rule processor handles policy Q&A, balances, and smart leave drafting!
GEMINI_API_KEY=your-gemini-api-key

# Application Base URL (Default for development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
